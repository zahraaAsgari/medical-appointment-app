# ─────────────────────────────────────────────────────────────
# Clinic Appointment Mini App — environment configuration
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

# REQUIRED (server-only) — PostgreSQL connection string (Drizzle/pg Pool).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# REQUIRED for real Telegram login (server-only). Bot token from @BotFather.
#   • If set, Telegram initData HMAC validation is enforced.
#   • If empty, authentication falls back to demo mode (dev only).
TELEGRAM_BOT_TOKEN=

# REQUIRED for production — disable the demo/preview login fallback.
# Demo auth is OFF unless this is EXACTLY "true" (case/whitespace tolerant).
# Production: leave unset or set "false" — only signed Telegram initData can log in.
# Local development only: set "true" to enable the demo login fallback.
ALLOW_DEMO_AUTH=

# OPTIONAL — freshness window (seconds) for Telegram initData auth_date.
# Default 300 (5 min). Raise for users who keep the Mini App in background
# (e.g. 86400) while still rejecting very old/forged payloads.
TELEGRAM_AUTH_MAX_AGE=300

# Set automatically to "production" by Node/Next on the host; enables the
# Secure flag on the session cookie. Not set manually in .env.
# NODE_ENV=production
